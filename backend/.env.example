# Copy to backend/.env and edit. All values are optional; defaults are shown.

# --- Models (the selectable models and LoRAs are listed in catalog.json) ---
# PROMPTCANVAS_CATALOG_PATH=catalog.json
# Catalog id to load at startup (empty = catalog's "default_model")
# PROMPTCANVAS_DEFAULT_MODEL=sd15
# Only for gated/private models. Never commit a real token.
# HF_TOKEN=

# --- Device: auto | cuda | mps | cpu ---
PROMPTCANVAS_DEVICE=auto
# auto | float16 | bfloat16 | float32  (auto = float16 on GPU, float32 on CPU)
PROMPTCANVAS_TORCH_DTYPE=auto
PROMPTCANVAS_ENABLE_ATTENTION_SLICING=false
PROMPTCANVAS_ENABLE_CPU_OFFLOAD=false

# --- Input limits (per-model defaults are in catalog.json) ---
PROMPTCANVAS_MIN_IMAGE_SIZE=256
PROMPTCANVAS_MAX_IMAGE_SIZE=1536
PROMPTCANVAS_MAX_STEPS=50
PROMPTCANVAS_MAX_GUIDANCE_SCALE=20
PROMPTCANVAS_MAX_PROMPT_LENGTH=1000
PROMPTCANVAS_MAX_BATCH_SIZE=4
PROMPTCANVAS_MAX_LORAS=3
PROMPTCANVAS_MAX_INIT_IMAGE_MB=10

# --- Queue ---
PROMPTCANVAS_MAX_QUEUE_SIZE=4
PROMPTCANVAS_QUEUE_TIMEOUT_SECONDS=300

# --- Server ---
# JSON list; only needed when the frontend is hosted on another origin.
# PROMPTCANVAS_CORS_ORIGINS=["http://localhost:5173"]
PROMPTCANVAS_SERVE_FRONTEND=true
PROMPTCANVAS_LOG_LEVEL=INFO

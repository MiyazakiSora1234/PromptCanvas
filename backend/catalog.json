      "repo": "stable-diffusion-v1-5/stable-diffusion-v1-5",
      "family": "sd15",
      "download_size_gb": 5.1,
      "defaults": { "width": 512, "height": 512, "num_inference_steps": 25, "guidance_scale": 7.5, "scheduler": "default" }
    },
    {
      "id": "sdxl",
      "label": "SDXL 1.0（高画質・写真風）",

      "variant": "fp16",
      "family": "sdxl",
      "download_size_gb": 7.2,
      "vae": { "repo": "madebyollin/sdxl-vae-fp16-fix" },
      "defaults": { "width": 1024, "height": 1024, "num_inference_steps": 30, "guidance_scale": 7.0, "scheduler": "default" }
    },
